# ============================================================
# StudyAbroad.AI — Multi-Service Hybrid Environment Configuration
# ============================================================
# Philosophy:
# 1. FREE Cloud LLMs (Groq, Gemini, OpenRouter) — $0/mo, zero GPU required
# 2. Multi-Tier Free Databases (Turso, Neon, MongoDB Atlas, Supabase) — 20+ GB storage at $0/mo
# 3. Hybrid Architecture (Next.js 16 + Node Stealth Scraper + Python AI FastAPI)
# ============================================================

APP_NAME="StudyAbroad.AI"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="studyabroad-ai-secret-key-change-in-production-2024"
API_HOST="0.0.0.0"
API_PORT=8000

# ============================================================
# 1. MULTI-DATABASE STRATEGY ($0/Month Free Tier Architecture)
# ============================================================
# Primary Relational DB (Default: SQLite for zero-config dev)
DATABASE_URL="sqlite+aiosqlite:///./data/studyabroad.db"

# Turso (LibSQL / SQLite at Edge — 500 databases, 9GB storage, 1B reads/mo FREE)
# Get keys: https://turso.tech
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Neon PostgreSQL (Serverless PostgreSQL — 0.5GB storage, 190 compute hours/mo FREE)
# Best for complex relational queries & analytics
# Get keys: https://neon.tech
NEON_DATABASE_URL=""

# MongoDB Atlas (Document Store — 512MB M0 cluster per project FREE)
# Best for raw scraped HTML/JSON, university catalogues, SOP drafts
# Get keys: https://www.mongodb.com/cloud/atlas
MONGODB_URL=""
MONGODB_DB_NAME="studyabroad"

# Supabase (Auth + File Storage — 1GB file storage FREE)
# Best for user uploaded documents (resumes, transcripts, SOP PDFs)
# Get keys: https://supabase.com
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="documents"

# Redis (Task queue + cross-service pub/sub — self-hosted on VPS or Upstash free)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ============================================================
# 2. FREE CLOUD LLM APIS (No local GPU/VPS needed!)
# ============================================================
# Chain: Groq (Primary) → Gemini (Secondary) → OpenRouter (Tertiary) → OpenAI (Emergency)
# Total monthly cost: $0.00

# 1. Groq (PRIMARY — FASTEST, 30 RPM, 14,400 req/day FREE)
# https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. Gemini Flash (SECONDARY — Google free tier, 15 RPM, 1M tokens/day FREE)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# 3. OpenRouter (TERTIARY — Free Qwen 32B, Llama 3.1, Mistral models)
# https://openrouter.ai
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwq-32b:free"

# 4. Paid Emergency Fallbacks (Avoid unless strictly required)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ============================================================
# 3. EMBEDDINGS & VECTOR STORE (In-Memory / Local, FREE)
# ============================================================
EMBEDDINGS_PRIMARY="fastembed"
EMBEDDINGS_MODEL="BAAI/bge-small-en-v1.5"
OPENAI_EMBEDDINGS_FALLBACK=false

VECTOR_STORE_PRIMARY="faiss"
VECTOR_INDEX_PATH="./data/vector_index"
VECTOR_DIMENSION=384
USE_PINECONE_FALLBACK=false

# ============================================================
# 4. SCRAPING (Node.js Stealth Service + Python Playwright)
# ============================================================
SCRAPER_SERVICE_URL="http://localhost:3001"
SCRAPER_PRIMARY="playwright"
SCRAPER_HEADLESS=true
SCRAPER_MAX_CONCURRENT=5
SCRAPER_RATE_LIMIT_SECONDS=2.0
SCRAPER_RETRY_ATTEMPTS=3

# ============================================================
# 5. EMAIL (Own SMTP — Gmail App Password, FREE)
# ============================================================
EMAIL_BACKEND="smtp"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM_NAME="StudyAbroad.AI"
EMAIL_FROM_ADDRESS=""

# ============================================================
# 6. AGENT SYSTEM & SERVICES
# ============================================================
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
ENABLE_AGENT_LOGGING=true
AGENT_MEMORY_WINDOW=10

FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:3001"
LOG_LEVEL="INFO"
LOG_FILE="./data/logs/app.log"
